{
    "name": "rust-feature-toggler",
    "displayName": "Rust Feature Toggler",
    "description": "Toggle Rust features on and off",
    "license": "MIT",
    "icon": "icon.jpeg",
    "publisher": "itsyaasir",
    "repository": {
        "url": "https://github.com/itsyaasir/rust-feature-toggle"
    },
    "keywords": [
        "rust",
        "feature",
        "toggle",
        "cargo"
    ],
    "version": "0.5.0",
    "engines": {
        "vscode": "^1.82.0"
    },
    "categories": [
        "Other",
        "Programming Languages"
    ],
    "author": {
        "name": "Yasir Shariff (itsyaasir)",
        "email": "yasir@shariff.dev"
    },
    "activationEvents": [
        "workspaceContains:*/Cargo.toml",
        "workspaceContains:Cargo.toml",
        "workspaceContains:*/rust-project.json"
    ],
    "main": "./extension.js",
    "contributes": {
        "languages": [
            {
                "id": "rust",
                "extensions": [
                    ".rs"
                ]
            },
            {
                "id": "toml",
                "extensions": [
                    ".toml"
                ]
            }
        ],
        "commands": [
            {
                "command": "rust-feature.toggleFeature",
                "title": "Rust Feature Toggler: Toggle Feature"
            }
        ]
    },
    "scripts": {
        "lint": "eslint .",
        "pretest": "yarn run lint",
        "test": "node ./test/runTest.js"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.1",
        "@types/node": "16.x",
        "@types/vscode": "^1.82.0",
        "@vscode/test-electron": "^2.3.9",
        "chai": "^4.3.8",
        "eslint": "^8.47.0",
        "mocha": "^10.2.0",
        "sinon": "^16.0.0",
        "typescript": "^5.1.6"
    },
    "dependencies": {
        "glob": "^11",
        "toml": "^3.0.0"
    },
    "packageManager": "yarn@3.2.0+sha512.bf8d01800977bb37695aa3a90c4ca70819b727165d8cc5dcc72a4de68d038bb38f49366f779fd2f9bd87f2e42ca70b1b5baefdce8ef4339459448be943d9265e"
}
